{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "repo-doctor 扫描结果契约",
  "type": "object",
  "required": ["project", "scanned_at", "target", "inventory", "issues", "skipped_rules", "score", "grade"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string" },
    "scanned_at": { "type": "string", "format": "date-time" },
    "target": { "type": "string" },
    "inventory": {
      "type": "object",
      "required": ["files", "source_files"],
      "additionalProperties": false,
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "source_files": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "file", "message"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "message": { "type": "string" },
          "suggestion": { "type": ["string", "null"] }
        }
      }
    },
    "skipped_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "reason"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "grade": { "type": "string", "enum": ["A", "B", "C", "D", "E", "F"] }
  }
}
